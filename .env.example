# Phase 1 支持本地 UTF-8 .env；同名进程环境变量优先。
# 从项目根目录启动，相对路径按当前工作目录解析；不要填写真实凭据到此文件。
NOVA_ENV=development
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
NOVA_LOG_LEVEL=INFO
NOVA_DATA_DIR=./data
NOVA_DATABASE_PATH=./data/nova.sqlite3
NOVA_DB_TIMEOUT=5
# DATA_DIR 与 DATABASE_PATH 独立；只改 DATA_DIR 不会迁移数据库。
# 以下为未来 Provider 预留字段，本阶段不使用、不要求密钥、不发网络请求。
NOVA_LLM_PROVIDER=deepseek
# 模型名称在后续 Provider 阶段核验后填写。
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=

# GPU首轮：仅回环地址、单worker；开启前在本地设置至少32字符随机令牌。
# 不将真实令牌写入本示例或Git。未启用时保持Phase1行为，不访问Ollama。
NOVA_GPU_ENABLED=false
NOVA_GPU_TOKEN=
NOVA_GPU_OLLAMA_URL=http://127.0.0.1:11434
NOVA_GPU_MODEL=qwen3.5:4b
NOVA_GPU_DRAIN_TIMEOUT=30
NOVA_GPU_REQUEST_TIMEOUT=120

# 游戏检测：先在任务管理器确认真实EXE名称，再填写JSON数组；不预置猜测值。
# 开启时要求NOVA_GPU_ENABLED=true且白名单非空。退出确认窗口固定60秒。
NOVA_GPU_GAME_DETECTION_ENABLED=false
NOVA_GPU_GAME_PROCESSES=[]
NOVA_GPU_GAME_POLL_SECONDS=5

# 无需白名单的新模式：与旧NOVA_GPU_GAME_DETECTION_ENABLED二选一。
# 两项都要求NOVA_GPU_ENABLED=true和管理令牌；不运行PresentMon。
NOVA_GPU_AUTO_GAME_ENABLED=false
# 独立显存压力保护，仅卸载空闲推理模型，不终止训练或其他GPU程序。
NOVA_GPU_MEMORY_PRESSURE_ENABLED=false

# V2聊天仍由GPU Manager准入；run_web.py会安全启用并在进程内生成令牌。
NOVA_CHAT_ENABLED=false
NOVA_CHAT_DEFAULT_MODEL=qwen3.5:9b
NOVA_CHAT_IDLE_SECONDS=180
# 云端默认关闭，选择DeepSeek还需要明确同意可能计费；不自动回退。
NOVA_CLOUD_ENABLED=false

# V3：可选实验模型；不替换9B/4B默认。当前16GB系统RAM会被安全门禁拒绝。
NOVA_QWEN38_ENABLED=false
NOVA_QWEN38_MODEL=hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q3_K_XL
NOVA_QWEN38_CONTEXT=4096
NOVA_QWEN38_NUM_PREDICT=256
NOVA_QWEN38_KEEP_ALIVE=180
# 空值由Ollama自动选择GPU层数，不能强制全GPU来绕过资源检查。
NOVA_QWEN38_NUM_GPU=
NOVA_QWEN38_TEMPERATURE=0.7
NOVA_QWEN38_MIN_TOTAL_RAM_MIB=28672
NOVA_QWEN38_MIN_AVAILABLE_RAM_MIB=18432
NOVA_QWEN38_MIN_FREE_VRAM_MIB=4096

